---
import { BUSINESS_NAME } from '../utils/constants';

const currentYear = new Date().getFullYear();
---

<footer class="py-10 px-4 bg-white border-t border-primary/10">
  <div class="max-w-7xl mx-auto flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm font-semibold text-primary">{BUSINESS_NAME}</p>
      <p class="mt-1 text-sm text-muted-foreground">Service scheduling with Wix Headless availability and confirmations.</p>
    </div>
    <p class="text-sm text-muted-foreground">
      &copy; {currentYear} {BUSINESS_NAME}. Thoughtful care, clearly booked.
    </p>
  </div>
</footer>
