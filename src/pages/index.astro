---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { BUSINESS_NAME } from "../utils/constants";

const features = [
  {
    title: "Care calendar sync",
    description: "Availability comes from Wix Bookings, so patients see current clinical windows without calling the desk.",
    label: "Availability",
  },
  {
    title: "Service-aware booking",
    description: "A no-fee intake call and a paid provider visit can share one headless flow while keeping the service logic in Wix.",
    label: "Services",
  },
  {
    title: "Clear confirmation",
    description: "Each booking ends with a calm appointment summary that keeps patient details and next steps easy to scan.",
    label: "Confirmations",
  },
];

const carePaths = [
  {
    title: "Care Match Call",
    time: "30 min",
    description: "A no-fee intake conversation that helps route patients to the right next step.",
  },
  {
    title: "Clinical Visit",
    time: "60 min",
    description: "A provider appointment with paid-service logic available through the same Wix-backed flow.",
  },
  {
    title: "Follow-up Ready",
    time: "Live slots",
    description: "The scheduler keeps the patient-facing experience calm while availability stays operationally real.",
  },
];

const assurances = ["Clear service choice", "Live appointment openings", "Readable confirmation"];
---

<Layout>
  <div class="min-h-screen bg-[#f4faf8]">
    <Navbar />

    <main>
      <section class="lumen-hero pt-28 pb-14 md:pt-36 md:pb-20">
        <div class="max-w-7xl mx-auto grid gap-12 px-4 sm:px-6 lg:grid-cols-[0.94fr_1.06fr] lg:items-center lg:px-8">
          <div class="animate-fade-up">
            <p class="mb-5 inline-flex rounded-lg border border-primary/10 bg-white/80 px-3 py-2 text-sm font-semibold uppercase text-primary/70 shadow-soft">Connected clinical scheduling</p>
            <h1 class="max-w-3xl text-5xl font-semibold leading-[1.04] text-primary sm:text-6xl">
              Care booking that feels settled before the visit starts.
            </h1>
            <p class="mt-6 max-w-2xl text-xl leading-8 text-slate-700">
              {BUSINESS_NAME} gives patients a gentle path through service choice, live openings, and confirmation while Wix Headless keeps the care calendar connected behind the scenes.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/schedule" class="inline-flex justify-center rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white shadow-[0_16px_36px_rgba(25,104,123,0.22)] transition-transform hover:-translate-y-0.5 hover:bg-primary/90">
                Schedule Care
              </a>
              <a href="#services" class="inline-flex justify-center rounded-lg border border-primary/20 bg-white px-6 py-3 text-sm font-semibold text-primary transition-colors hover:bg-secondary">
                View Care Paths
              </a>
            </div>
            <div class="mt-10 grid max-w-2xl gap-3 sm:grid-cols-3">
              {assurances.map((item) => (
                <div class="lumen-assurance">
                  <span></span>
                  <strong>{item}</strong>
                </div>
              ))}
            </div>
          </div>

          <div class="lumen-care-board animate-fade-up" style="animation-delay: 120ms;">
            <div class="lumen-board-topline">
              <span>Today at {BUSINESS_NAME}</span>
              <strong>Live</strong>
            </div>
            <div class="lumen-care-row">
              <span class="lumen-dot"></span>
              <div>
                <strong>Care Match Call</strong>
                <p>Intake conversation</p>
              </div>
              <time>9:30 AM</time>
            </div>
            <div class="lumen-care-row">
              <span class="lumen-dot is-warm"></span>
              <div>
                <strong>Clinical Visit</strong>
                <p>Provider appointment</p>
              </div>
              <time>1:00 PM</time>
            </div>
            <div class="lumen-care-row">
              <span class="lumen-dot is-muted"></span>
              <div>
                <strong>Confirmation Ready</strong>
                <p>Email, phone, and appointment summary</p>
              </div>
              <time>After booking</time>
            </div>
            <div class="lumen-note">
              Patient-facing booking, powered by Wix services, availability, and checkout-ready service logic.
            </div>
          </div>
        </div>
      </section>

      <section id="services" class="py-16 bg-white md:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-12 grid gap-6 md:grid-cols-[0.9fr_1fr] md:items-end">
            <div>
              <p class="text-sm font-semibold uppercase text-primary/70">Booking that respects attention</p>
              <h2 class="mt-3 text-3xl font-semibold text-slate-950 md:text-5xl">A clinic scheduler should feel composed before it feels clever.</h2>
            </div>
            <p class="text-muted-foreground">
              The experience gives patients the essentials first: what type of visit they are choosing, what times are available, and what happens after they confirm.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
            {carePaths.map((path) => (
              <article class="lumen-path-card">
                <p>{path.time}</p>
                <h3>{path.title}</h3>
                <span>{path.description}</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="lumen-capability-section py-16 md:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-10 max-w-3xl">
            <p class="text-sm font-semibold uppercase text-primary/70">What Wix keeps connected</p>
            <h2 class="mt-3 text-3xl font-semibold text-slate-950 md:text-4xl">The operational system stays intact; the patient experience becomes calmer.</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            {features.map((feature, index) => (
              <div class="lumen-feature-card animate-fade-up" style={`animation-delay: ${index * 100 + 200}ms`}>
                <p class="mb-8 text-xs font-semibold uppercase text-primary/60">{feature.label}</p>
                <h3 class="text-xl font-semibold mb-3 text-slate-950">{feature.title}</h3>
                <p class="text-muted-foreground">{feature.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="py-16 bg-secondary">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
            <div class="animate-fade-up">
              <p class="text-sm font-semibold uppercase text-primary/70">Ready when care is needed</p>
              <h2 class="mt-3 max-w-3xl text-3xl font-semibold text-primary md:text-5xl">Choose a visit type and see the next available opening.</h2>
            </div>
            <a href="/schedule" class="inline-flex justify-center rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary/90 animate-fade-up" style="animation-delay: 120ms;">
              Open Scheduler
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
